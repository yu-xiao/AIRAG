JWT_SECRET=please-change-me-32-chars-minimum
JWT_EXPIRE_MINUTES=60
# 本机 Redis 若设置了 requirepass(本机当前如此),必须带密码,形如:
# REDIS_URL=redis://:<你的redis密码>@localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
ZHIPU_API_KEY=
# 问答对话模型(M3 起 LangGraph generate 节点使用);flash 档省 token
CHAT_MODEL=glm-5.3-flash
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=2048
RERANK_ENABLED=false
RERANK_MODEL=rerank-3
RETRIEVAL_TOP_K=8
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_PROVIDER=zhipu
EMBED_MODEL=embedding-3
EMBED_DIMS=1024
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=20
