JWT_SECRET=please-change-me-32-chars-minimum
JWT_EXPIRE_MINUTES=60
# 本机 Redis 若设置了 requirepass(本机当前如此),必须带密码,形如:
# REDIS_URL=redis://:<你的redis密码>@localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
ZHIPU_API_KEY=
# 问答对话模型(M3 起 LangGraph generate 节点使用);flash 档省 token
CHAT_MODEL=glm-5.3-flash
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=2048
RERANK_ENABLED=false
# M4 实测:智谱文本重排序模型编码为 "rerank"(文档枚举仅此值)
RERANK_MODEL=rerank
RETRIEVAL_TOP_K=8
# M7:rerank 相关度阈值(仅 rerank 开启时生效);默认 0=禁用——智谱 rerank
# relevance_score 实测全量饱和 0.92~1.0(零命中/正常分布重叠,无可行阈值)
RETRIEVAL_MIN_SCORE=0
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_PROVIDER=zhipu
EMBED_MODEL=embedding-3
EMBED_DIMS=1024
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=20
# M5:MinerU 云 API token(https://mineru.net API 管理页创建);留空则 OCR 整体关闭
MINERU_API_TOKEN=
# M6:多跳兜底(检索不足且重检仍不足/零命中时拆子问题再检索);MAX_SUBQ 为子问题上限
MULTI_HOP_ENABLED=true
MULTI_HOP_MAX_SUBQ=3
# M6:审计日志留存天数(超期自动清理,Windows 下另开窗口运行 backend\start_beat.bat,每日 03:00 执行;不开 beat 时可用 admin 手动 purge 端点);0 = 禁用
AUDIT_RETENTION_DAYS=180
# M9 Agent 对外开放(REST /api/agent/* + MCP /mcp)
AGENT_API_ENABLED=true
AGENT_RATE_LIMIT_PER_MIN=60
AGENT_MAX_KEYS_PER_USER=10
